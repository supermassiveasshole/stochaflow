experiment:
  name: __STOCHAFLOW_PROJECT_SLUG__-example
  seed: 42
  output_dir: outputs/example

extensions:
  plugins:
    - __STOCHAFLOW_PROJECT_SLUG__

data:
  name: __STOCHAFLOW_PROJECT_SLUG__.synthetic-regression
  params:
    input_features: 3
    train_samples: 32
    validation_samples: 8
    batch_size: 8
    noise_std: 0.02

model:
  name: __STOCHAFLOW_PROJECT_SLUG__.linear-regression
  params:
    input_features: 3

training:
  name: __STOCHAFLOW_PROJECT_SLUG__.regression
  params: {}

objective:
  name: mse
  params: {}

process: null

optimizer:
  name: torch.optim.Adam
  params:
    lr: 0.05

lr_scheduler:
  name: torch.optim.lr_scheduler.StepLR
  interval: epoch
  params:
    step_size: 1
    gamma: 0.9

ema:
  enabled: true
  decay: 0.9
  update_after_step: 0
  update_every: 1

diagnostics:
  - name: __STOCHAFLOW_PROJECT_SLUG__.regression-quality
    params:
      every_steps: 1

trainer:
  num_epochs: 2
  device: cpu
  max_grad_norm: null
  show_progress: true

logging:
  log_every: 1
  backends:
    - name: local
      params:
        console: true
    - name: tensorboard
      params: {}
  torch_logs: {}

artifacts:
  checkpoint_every: 1
